{
  "name": "ocf-backend",
  "version": "1.0.0",
  "description": "OCF — Oromo Cultural Fashion Backend API",
  "main": "server.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test admin-validation.test.js && node scripts/migrate-staging.test.js",
    "test:db": "node -e \"require('./database/db').getDB().then(()=>console.log('✅ DB OK')).catch(err=>{console.error('DB connection failed:',err.code||err.message);process.exitCode=1})\"",
    "test:api": "node test_api.js",
    "test:full": "node full_stack_test.js",
    "test:upload": "node test_upload.js",
    "test:delete": "node test_product_delete.js",
    "test:security": "node test_security_audit.js",
    "test:smoke": "node smoke_test.js",
    "test:idempotency": "node test_checkout_idempotency.js",
    "test:migrate-staging": "node scripts/migrate-staging.test.js",
    "migrate": "node migrations/migrate.js",
    "migrate:staging": "node scripts/migrate-staging.js",
    "migrate:data": "node migrations/migrate_data.js",
    "sync:catalog": "node migrations/sync_catalog_to_pg.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "pg": "^8.23.1"
  }
}
