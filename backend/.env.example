# ==========================================
# OCF Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control!
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production
# Storage path for uploads (optional, defaults to ./uploads; set to persistent disk mount e.g. /var/data/uploads on Render)
# UPLOADS_DIR=/var/data/uploads

# Database (PostgreSQL / Supabase connection string)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL=postgresql://postgres:your_strong_password@your_db_host:5432/postgres?sslmode=require

# Authentication (JWT)
# In production, JWT_SECRET MUST be at least 32 characters long and cryptographically random
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# CORS & Frontend Origins
# URL of your deployed frontend (e.g., https://ocf-fashion.com)
FRONTEND_URL=https://your-frontend-domain.com

# Initial Administrator Credentials (used during initial migration/seed)
ADMIN_EMAIL=admin@ocf.com
ADMIN_PASSWORD=change_this_admin_password_in_production

# Email Service (Nodemailer / SMTP - optional for local dev, required for production order emails)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=notifications@your-domain.com
EMAIL_PASS=your_smtp_app_password
