# ==========================================
# OCF Backend — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control!
# ==========================================

# Server Configuration
PORT=5000
NODE_ENV=production
# Local upload storage is ephemeral on Render Free and is not suitable for persistent images.

# Database (use only the separate Neon staging database for staging)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=verify-full
DATABASE_URL=postgresql://postgres:your_strong_password@your_db_host:5432/postgres?sslmode=verify-full

# Authentication (JWT)
# In production, JWT_SECRET MUST be at least 32 characters long and cryptographically random
# Set this only in the hosting provider's protected secret settings.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# CORS & Frontend Origins
# Exact comma-separated origins only. Do not include paths or local origins in production.
FRONTEND_URL=https://your-staging-project.pages.dev

# One-time staging scripts require the Neon Direct endpoint; pooled endpoints are rejected.
# They use only this dedicated URL; DATABASE_URL is never used.
# Configure the hostname and database-name allowlists independently from Neon.
# Do not derive them automatically from OCF_STAGING_DATABASE_URL.
# OCF_STAGING_ONLY=YES
# OCF_STAGING_DATABASE_URL=<direct-staging-postgresql-url>
# OCF_STAGING_ALLOWED_DATABASE_HOST=<exact-lowercase-direct-neon-hostname>
# OCF_STAGING_ALLOWED_DATABASE_NAME=<exact-staging-database-name>
# STAGING_ADMIN_EMAIL=<staging-admin-email>
# STAGING_ADMIN_PASSWORD=<unique-strong-temporary-password>
