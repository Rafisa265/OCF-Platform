# Render Free staging Blueprint example.
# Free services have ephemeral filesystems: uploads are lost on restart, spin-down, or redeploy.
# Do not use this configuration for reliable production ecommerce.

services:
  - type: web
    name: ocf-staging-backend
    env: node
    plan: free
    rootDir: backend
    buildCommand: npm install --omit=dev
    startCommand: npm start
    healthCheckPath: /api/health
    envVars:
      - key: NODE_ENV
        value: production
      - key: DATABASE_URL
        sync: false # Set only to the separate Neon staging database URL.
      - key: JWT_SECRET
        generateValue: true
      - key: JWT_EXPIRES_IN
        value: 7d
      - key: FRONTEND_URL
        sync: false # Set to the exact Cloudflare Pages staging origin.
